{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumen课程表",
  "version": "0.1.0",
  "identifier": "com.lumen.deskcourse",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5183",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "mini",
        "url": "mini.html",
        "title": "今日课程",
        "width": 384,
        "height": 560,
        "minWidth": 320,
        "minHeight": 300,
        "resizable": true,
        "center": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "x": 40,
        "y": 80,
        "visible": true,
        "dragDropEnabled": true
      },
      {
        "label": "main",
        "url": "index.html",
        "title": "Lumen 课程表",
        "width": 1280,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 680,
        "resizable": true,
        "center": true,
        "decorations": true,
        "transparent": false,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": { "csp": null },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    },
    "shortDescription": "iOS 风格桌面课程表 + 极简今日浮窗",
    "longDescription": "Lumen 课程表：Excel 导入、开课提醒、拖动改课、作业待办与 DDL 管理，并附带常驻桌面的极简今日浮窗。"
  }
}
