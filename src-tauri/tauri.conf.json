{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumen课程表",
  "version": "0.1.0",
  "identifier": "com.lumen.deskcourse",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5183",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lumen 课程表",
        "width": 1280,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 680,
        "resizable": true,
        "center": true,
        "decorations": true,
        "transparent": false,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": { "csp": null },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    },
    "shortDescription": "iOS 风格桌面课程表",
    "longDescription": "Lumen 课程表：Excel 导入、开课提醒、拖动改课、作业待办与 DDL 管理。"
  }
}
