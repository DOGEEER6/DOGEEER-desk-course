{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DOGEEER课表",
  "version": "0.1.0",
  "identifier": "com.lumen.deskcourse",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5183",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "mini",
        "url": "mini.html",
        "title": "DOGEEER 今日",
        "width": 400,
        "height": 400,
        "minWidth": 320,
        "minHeight": 220,
        "resizable": true,
        "center": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true,
        "dragDropEnabled": true
      },
      {
        "label": "main",
        "url": "index.html",
        "title": "DOGEEER 课表",
        "width": 1300,
        "height": 880,
        "minWidth": 1080,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": { "csp": null },
    "withGlobalTauri": true,
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": false,
      "tooltip": "DOGEEER 课表"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "resources": {
      "target/release/WebView2Loader.dll": "WebView2Loader.dll"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    },
    "shortDescription": "iOS 风格桌面课程表 + 桌面浮窗",
    "longDescription": "DOGEEER 课表：Excel 导入、开课提醒、拖动改课、作业待办与 DDL 管理，并附带常驻桌面的今日浮窗。"
  }
}
